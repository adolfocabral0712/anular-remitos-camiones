{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anular-remitos-camiones",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anular-remitos-db",
      "database_id": "18db5fe8-e19b-4dca-b7cd-1ff58cd558bb"
    }
  ],

  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
